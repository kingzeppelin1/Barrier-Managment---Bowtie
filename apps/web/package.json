    "@bowtie/ui": "workspace:*",
    "next": "^16.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^20.16.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^2.1.1",
    "eslint": "^9.13.0",
    "eslint-config-next": "^15.0.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.1"
  }
}
